# Copy to .env and fill in. Never commit .env.

# --- Required -------------------------------------------------------------------------------------------------------------
# Database password (the user is "rsp"). Use a long random value: openssl rand -hex 24
POSTGRES_PASSWORD=
# Signs the photo download links. At least 32 random characters: openssl rand -hex 32
# Changing it invalidates links already given out (guests would have to open them again).
SESSION_SECRET=
# The https address guests and staff use (no trailing slash). QR codes are built from it.
PUBLIC_BASE_URL=https://photos.example.com

# --- Reverse proxy --------------------------------------------------------------------------------------------------------
# The address Caddy serves and gets a certificate for. "localhost" uses a local test certificate.
SITE_ADDRESS=photos.example.com
# Host ports (change only if 80/443 are taken).
HTTP_PORT=80
HTTPS_PORT=443

# --- Optional -------------------------------------------------------------------------------------------------------------
LOG_LEVEL=info
